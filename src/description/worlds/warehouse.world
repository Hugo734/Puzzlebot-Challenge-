    <!-- ======================================================= -->
    <!-- Pallets (6 units) — 0.15 x 0.15 x 0.05 m               -->
    <!-- static=false so the robot can pick them up              -->
    <!-- Colors: red (2), blue (2), green (2)                    -->
    <!-- Positions:                                              -->
    <!--   pallet_red_1   — rack_1 shelf level 1 (z=0.215)      -->
    <!--   pallet_red_2   — rack_1 shelf level 2 (z=0.465)      -->
    <!--   pallet_blue_1  — rack_2 shelf level 1 (z=0.215)      -->
    <!--   pallet_blue_2  — rack_2 shelf level 2 (z=0.465)      -->
    <!--   pallet_green_1 — roller_1 (z=0.125)                  -->
    <!--   pallet_green_2 — roller_2 (z=0.125)                  -->
    <!-- ======================================================= -->

    <model name="pallet_red_1">
      <static>false</static>
      <pose>0.5 0.5 0.235 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.3</mass>
          <inertia>
            <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0002</iyy><iyz>0</iyz>
            <izz>0.0004</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.05</size></box></geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
