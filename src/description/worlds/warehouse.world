    <!-- ======================================================= -->

    <!-- Rack 1 frame at (0.5, 0.5) -->
    <model name="rack_1_frame">
      <static>true</static>
      <pose>0.5 0.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
