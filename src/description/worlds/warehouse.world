<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse">

    <physics name="1ms" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================= -->
    <!-- Boundary walls — 4 m x 4 m warehouse floor area         -->
    <!-- Wall thickness 0.1 m, height 0.8 m                     -->
    <!-- Area from (0,0) to (4,4)  — walls centred on edges      -->
    <!-- ======================================================= -->

    <!-- South wall: y=0, spans x=0..4 -->
    <model name="wall_south">
      <static>true</static>
      <pose>2.0 0.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.1 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.1 0.8</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- North wall: y=4, spans x=0..4 -->
    <model name="wall_north">
      <static>true</static>
      <pose>2.0 4.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.1 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.1 0.8</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall: x=0, spans y=0..4 -->
    <model name="wall_west">
      <static>true</static>
      <pose>0.0 2.0 0.4 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.1 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.1 0.8</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
