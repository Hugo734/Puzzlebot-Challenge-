<?xml version="1.0"?>
<sdf version="1.8">
  <world name="warehouse">

    <!-- Required Ignition Fortress system plugins -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Sensor system for gpu_lidar (uses Mesa software GL via LIBGL_ALWAYS_SOFTWARE=1) -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ═══════════════════════════════ GROUND ══════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.33 0.33 0.33 1</ambient>
            <diffuse>0.38 0.38 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════ WALLS ═══════════════════════════════ -->
    <!-- Interior: 12 m (x) × 10 m (y), centred at origin.                   -->
    <!-- Walls: 0.15 m thick, 2.0 m tall.                                     -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 5.075 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.3 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.3 0.15 2.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.075 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.3 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.3 0.15 2.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6.075 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.3 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.3 2.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6.075 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.3 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.3 2.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════ ZONA 1: CAMIONES / TRUCKS (north, y=4.0) ════════════ -->
    <!-- 3 docking trucks against the north wall, spaced 3.5 m apart.         -->
    <!-- Body 1.9×1.5×1.0 m, cab 1.9×0.8×0.7 m on top (blue).               -->
    <!-- Loading-dock face points south (−y), toward the robot.               -->

    <model name="truck_1">
      <static>true</static>
      <pose>-3.5 4.0 0 0 0 0</pose>
      <link name="link">
        <collision name="body">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.90 1.50 1.00</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.90 1.50 1.00</size></box></geometry>
          <material><ambient>0.08 0.18 0.70 1</ambient><diffuse>0.10 0.25 0.85 1</diffuse></material>
        </visual>
        <collision name="cab">
          <pose>0 0.35 1.35 0 0 0</pose>
          <geometry><box><size>1.90 0.80 0.70</size></box></geometry>
        </collision>
        <visual name="cab">
          <pose>0 0.35 1.35 0 0 0</pose>
          <geometry><box><size>1.90 0.80 0.70</size></box></geometry>
          <material><ambient>0.08 0.18 0.70 1</ambient><diffuse>0.10 0.25 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="truck_2">
      <static>true</static>
      <pose>0 4.0 0 0 0 0</pose>
      <link name="link">
        <collision name="body">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.90 1.50 1.00</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.90 1.50 1.00</size></box></geometry>
          <material><ambient>0.08 0.18 0.70 1</ambient><diffuse>0.10 0.25 0.85 1</diffuse></material>
        </visual>
        <collision name="cab">
          <pose>0 0.35 1.35 0 0 0</pose>
          <geometry><box><size>1.90 0.80 0.70</size></box></geometry>
        </collision>
        <visual name="cab">
          <pose>0 0.35 1.35 0 0 0</pose>
          <geometry><box><size>1.90 0.80 0.70</size></box></geometry>
          <material><ambient>0.08 0.18 0.70 1</ambient><diffuse>0.10 0.25 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="truck_3">
      <static>true</static>
      <pose>3.5 4.0 0 0 0 0</pose>
      <link name="link">
        <collision name="body">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.90 1.50 1.00</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.90 1.50 1.00</size></box></geometry>
          <material><ambient>0.08 0.18 0.70 1</ambient><diffuse>0.10 0.25 0.85 1</diffuse></material>
        </visual>
        <collision name="cab">
          <pose>0 0.35 1.35 0 0 0</pose>
          <geometry><box><size>1.90 0.80 0.70</size></box></geometry>
        </collision>
        <visual name="cab">
          <pose>0 0.35 1.35 0 0 0</pose>
          <geometry><box><size>1.90 0.80 0.70</size></box></geometry>
          <material><ambient>0.08 0.18 0.70 1</ambient><diffuse>0.10 0.25 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════ ZONA 2: RACKS (central, y=2.5 and y=1.2) ═══════ -->
    <!-- 6 racks: 2 rows × 3 cols.  Row A: y=2.5, Row B: y=1.2.              -->
    <!-- x positions: −3.5, 0, +3.5.  Aisle between rows ≈ 1.1 m.            -->
    <!-- Each rack: 4 vertical posts (0.06×0.06×1.2) at corners ±(0.70,0.20) -->
    <!-- + 2 shelf panels (1.44×0.40×0.04) at z=0.35 and z=0.80.             -->
    <!-- Orange posts / darker-orange shelves.                                 -->
    <!-- LiDAR at z≈0.13 m will see the posts (floor-to-1.2 m).              -->

    <!-- rack_a1: x=−3.5, y=2.5 -->
    <model name="rack_a1">
      <static>true</static>
      <pose>-3.5 2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry></collision>
        <visual    name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry><material><ambient>0.55 0.28 0.00 1</ambient><diffuse>0.65 0.33 0.00 1</diffuse></material></visual>
        <collision name="s2"><pose>0 0 0.80 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry></collision>
        <visual    name="s2"><pose>0 0 0.80 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry><material><ambient>0.55 0.28 0.00 1</ambient><diffuse>0.65 0.33 0.00 1</diffuse></material></visual>
      </link>
    </model>

    <!-- rack_a2: x=0, y=2.5 -->
    <model name="rack_a2">
      <static>true</static>
      <pose>0 2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry></collision>
        <visual    name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry><material><ambient>0.55 0.28 0.00 1</ambient><diffuse>0.65 0.33 0.00 1</diffuse></material></visual>
        <collision name="s2"><pose>0 0 0.80 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry></collision>
        <visual    name="s2"><pose>0 0 0.80 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry><material><ambient>0.55 0.28 0.00 1</ambient><diffuse>0.65 0.33 0.00 1</diffuse></material></visual>
      </link>
    </model>

    <!-- rack_a3: x=+3.5, y=2.5 -->
    <model name="rack_a3">
      <static>true</static>
      <pose>3.5 2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry></collision>
        <visual    name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry><material><ambient>0.55 0.28 0.00 1</ambient><diffuse>0.65 0.33 0.00 1</diffuse></material></visual>
        <collision name="s2"><pose>0 0 0.80 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry></collision>
        <visual    name="s2"><pose>0 0 0.80 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry><material><ambient>0.55 0.28 0.00 1</ambient><diffuse>0.65 0.33 0.00 1</diffuse></material></visual>
      </link>
    </model>

    <!-- rack_b1: x=−3.5, y=1.2 -->
    <model name="rack_b1">
      <static>true</static>
      <pose>-3.5 1.2 0 0 0 0</pose>
      <link name="link">
        <collision name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry></collision>
        <visual    name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry><material><ambient>0.55 0.28 0.00 1</ambient><diffuse>0.65 0.33 0.00 1</diffuse></material></visual>
        <collision name="s2"><pose>0 0 0.80 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry></collision>
        <visual    name="s2"><pose>0 0 0.80 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry><material><ambient>0.55 0.28 0.00 1</ambient><diffuse>0.65 0.33 0.00 1</diffuse></material></visual>
      </link>
    </model>

    <!-- rack_b2: x=0, y=1.2 -->
    <model name="rack_b2">
      <static>true</static>
      <pose>0 1.2 0 0 0 0</pose>
      <link name="link">
        <collision name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfl"><pose>-0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pfr"><pose> 0.70 -0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbl"><pose>-0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry></collision>
        <visual    name="pbr"><pose> 0.70  0.20 0.60 0 0 0</pose><geometry><box><size>0.06 0.06 1.20</size></box></geometry><material><ambient>0.70 0.35 0.00 1</ambient><diffuse>0.80 0.40 0.00 1</diffuse></material></visual>
        <collision name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry></collision>
        <visual    name="s1"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.44 0.40 0.04</size></box></geometry><material><ambient>0.55 0.28 0.00 1</ambient><diffuse>0.65 0.33 0.00 1</diffuse></material></visual>
