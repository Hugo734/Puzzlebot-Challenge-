<?xml version="1.0" ?>
<!--
  Warehouse world — 12 pallet racks in two groups of 6.
  Rack size (scale 0.03): 0.36 m deep × 1.05 m long × 0.795 m tall.

  Layout (top-down, X = forward, Y = left):

    X=-1.98..−1.62  Row A (outer, group 1)  ─┐
    X=-1.62..−1.26  Row B (inner, group 1)  ─┤  group 1
                                               │
    ←     2.52 m central aisle (X −1.26..+1.26) ─┤

    X=+1.26..+1.62  Row C (inner, group 2)  ─┤  group 2
    X=+1.62..+1.98  Row D (outer, group 2)  ─┘

  Each row has 3 racks placed end-to-end along Y at y = -1.05, 0, +1.05.
  Model origin = footprint centre at floor level (Z = 0).
  Room: 10 m × 10 m  (walls at ±5 m).
  Outer aisles: ≈ 3 m (X) and ≈ 3.4 m (Y ends).

  Robot spawns at the world origin (centre of the central aisle).
-->
<sdf version="1.6">
  <world name="warehouse">

    <physics name="1ms" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Overhead directional light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.95</direction>
    </light>

    <!-- Ground plane (concrete grey) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Warehouse walls (room 10 m × 10 m) ===== -->
    <!-- North wall (y = +5.0) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.2 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 1.8</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.68 1</ambient>
            <diffuse>0.72 0.72 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall (y = -5.0) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.2 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 1.8</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.68 1</ambient>
            <diffuse>0.72 0.72 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall (x = +5.0) -->
    <model name="wall_east">
      <static>true</static>
      <pose>5.0 0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 1.8</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.68 1</ambient>
            <diffuse>0.72 0.72 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall (x = -5.0) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5.0 0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 1.8</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.68 1</ambient>
            <diffuse>0.72 0.72 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Rack group 1 — left (negative X) ===== -->

    <!-- Row A (outer, x = -1.8) -->
    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_A1</name>
      <pose>-1.8 -1.05 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_A2</name>
      <pose>-1.8 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_A3</name>
      <pose>-1.8 1.05 0 0 0 0</pose>
    </include>

    <!-- Row B (inner, x = -1.44) — back-to-back with Row A -->
    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_B1</name>
      <pose>-1.44 -1.05 0 0 0 3.14159</pose>
    </include>

    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_B2</name>
      <pose>-1.44 0 0 0 0 3.14159</pose>
    </include>

    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_B3</name>
      <pose>-1.44 1.05 0 0 0 3.14159</pose>
    </include>

    <!-- ===== Rack group 2 — right (positive X) ===== -->

    <!-- Row C (inner, x = +1.44) — back-to-back with Row D -->
    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_C1</name>
      <pose>1.44 -1.05 0 0 0 3.14159</pose>
    </include>

    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_C2</name>
      <pose>1.44 0 0 0 0 3.14159</pose>
    </include>

    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_C3</name>
      <pose>1.44 1.05 0 0 0 3.14159</pose>
    </include>

    <!-- Row D (outer, x = +1.8) -->
    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_D1</name>
      <pose>1.8 -1.05 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_D2</name>
      <pose>1.8 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://warehouse_rack</uri>
      <name>rack_D3</name>
      <pose>1.8 1.05 0 0 0 0</pose>
    </include>

  </world>
</sdf>
